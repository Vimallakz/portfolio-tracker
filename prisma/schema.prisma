// Portfolio Intelligence Tracker — database schema
//
// Ownership: a User owns Profiles, and every piece of personal data (snapshots,
// research, tags, import sessions) hangs off Profile.id. Securities and their
// CSV name aliases are a shared master: they hold objective facts only, so two
// profiles holding GRAB point at the same Security row but never see each
// other's holdings, research or tags.
//
// Money and quantities are Decimal, never Float, so totals do not drift.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SecurityType {
  STOCK
  ETF
}

enum SnapshotSource {
  TICKERTAPE_CSV
}

enum Conviction {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum InvestmentStatus {
  WATCH
  ACCUMULATE
  HOLD
  REDUCE
  EXIT
}

enum ImportSessionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  FAILED
}

/// Account owner. Version 1 has no login, so a single local user row is created
/// on first use and every profile belongs to it. This keeps the ownership chain in place for
/// when real authentication is added.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles Profile[]

  @@map("users")
}

/// An investment profile (for example "Vimal" or "Wife"). This is the scope
/// boundary for all portfolio data: never read a profile's rows without
/// filtering on profileId.
model Profile {
  id     String @id @default(cuid())
  userId String

  name  String
  email String?
  phone String?
  notes String?

  /// Sensitive. Never select into a default query, never log, and render masked
  /// in the UI via maskPan().
  panNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots      PortfolioSnapshot[]
  research       SecurityResearch[]
  tags           Tag[]
  importSessions ImportSession[]

  @@unique([userId, name])
  @@index([userId])
  @@map("profiles")
}

/// Shared security master. Objective facts only; anything subjective belongs in
/// SecurityResearch. The Tickertape URL is not stored: it is derived from
/// tickertapeTicker (or ticker) by getTickertapeUrl() so it cannot be injected.
model Security {
  id       String       @id @default(cuid())
  name     String
  /// Null until the user maps it: Tickertape CSVs carry names, not tickers.
  /// Postgres treats NULLs as distinct, so unmapped rows never collide.
  ticker   String?
  type     SecurityType
  exchange String?
  /// ISO 3166-1 alpha-2. MVP data is US-listed.
  country  String       @default("US")

  /// Set only when Tickertape's slug differs from ticker.
  tickertapeTicker String?

  sector      String?
  industry    String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  aliases  SecurityAlias[]
  holdings SnapshotHolding[]
  research SecurityResearch[]
  tags     SecurityTag[]

  @@unique([country, ticker])
  @@index([type])
  @@map("securities")
}

/// Remembers how a CSV "Stock Name" maps to a Security, so a manual mapping is
/// made once and reused by every later import.
model SecurityAlias {
  id         String @id @default(cuid())
  securityId String

  /// Name as it appeared in the CSV.
  sourceName     String
  /// Lowercased, whitespace-collapsed sourceName; the lookup key.
  normalizedName String @unique

  createdAt DateTime @default(now())

  security Security @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@index([securityId])
  @@map("security_aliases")
}

/// What one profile's portfolio looked like when a CSV was confirmed.
/// Immutable: a new import always creates a new snapshot.
model PortfolioSnapshot {
  id           String         @id @default(cuid())
  profileId    String
  snapshotDate DateTime       @db.Date
  source       SnapshotSource @default(TICKERTAPE_CSV)
  fileName     String?
  /// SHA-256 of the normalised CSV content, used for duplicate detection.
  contentHash  String?

  createdAt DateTime @default(now())

  profile       Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  holdings      SnapshotHolding[]
  importSession ImportSession?

  @@index([profileId, snapshotDate])
  @@index([profileId, contentHash])
  @@map("portfolio_snapshots")
}

/// One security's row inside a snapshot, exactly as the CSV reported it.
/// Immutable: never update these rows after the snapshot is created.
model SnapshotHolding {
  id         String @id @default(cuid())
  snapshotId String
  securityId String

  /// Name as it appeared in the CSV, kept for audit.
  sourceName String

  quantity        Decimal @db.Decimal(20, 6)
  averageBuyPrice Decimal @db.Decimal(20, 4)
  investedAmount  Decimal @db.Decimal(20, 4)

  currentPrice Decimal @db.Decimal(20, 4)
  currentValue Decimal @db.Decimal(20, 4)

  /// Percentage of the snapshot's total value, 0–100.
  weight        Decimal @db.Decimal(9, 4)
  pnlAmount     Decimal @db.Decimal(20, 4)
  pnlPercentage Decimal @db.Decimal(12, 4)

  createdAt DateTime @default(now())

  snapshot PortfolioSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  security Security          @relation(fields: [securityId], references: [id], onDelete: Restrict)

  @@unique([snapshotId, securityId])
  @@index([securityId])
  @@map("snapshot_holdings")
}

/// A profile's personal research on a security. Subjective by design, and kept
/// apart from imported facts.
model SecurityResearch {
  id         String @id @default(cuid())
  profileId  String
  securityId String

  thesis    String?
  whyBought String?

  bullCase String?
  baseCase String?
  bearCase String?

  businessDescription String?

  targetPrice     Decimal? @db.Decimal(20, 4)
  accumulationMin Decimal? @db.Decimal(20, 4)
  accumulationMax Decimal? @db.Decimal(20, 4)
  stopPrice       Decimal? @db.Decimal(20, 4)

  expectedHoldingPeriod String?

  conviction       Conviction?
  investmentStatus InvestmentStatus?

  risks         String?
  personalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile  Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  security Security @relation(fields: [securityId], references: [id], onDelete: Cascade)

  @@unique([profileId, securityId])
  @@index([securityId])
  @@map("security_research")
}

/// A profile's custom label, such as "Growth" or "Core".
model Tag {
  id        String @id @default(cuid())
  profileId String
  name      String

  createdAt DateTime @default(now())

  profile    Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  securities SecurityTag[]

  @@unique([profileId, name])
  @@map("tags")
}

/// Tags are profile-scoped, so a SecurityTag row is implicitly scoped to the
/// tag's profile.
model SecurityTag {
  securityId String
  tagId      String

  createdAt DateTime @default(now())

  security Security @relation(fields: [securityId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([securityId, tagId])
  @@index([tagId])
  @@map("security_tags")
}

/// Holds a parsed CSV between upload and confirmation, so the confirmed import
/// is exactly what was previewed and the browser never resubmits holdings.
model ImportSession {
  id        String              @id @default(cuid())
  profileId String
  status    ImportSessionStatus @default(PENDING)

  fileName    String
  contentHash String
  rowCount    Int
  /// Parsed, validated holdings. Not the raw CSV text.
  payload     Json

  error String?

  /// Set when the session is confirmed.
  snapshotId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile  Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  snapshot PortfolioSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([profileId, status])
  @@map("import_sessions")
}
