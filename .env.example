# Copy to .env and fill in real values. Never commit .env.

# Connection used by the application at runtime.
# Local:  postgresql://USER@localhost:5432/portfolio_tracker?schema=public
# Neon:   use the POOLED connection string (host contains "-pooler")
DATABASE_URL="postgresql://USER@localhost:5432/portfolio_tracker?schema=public"

# Direct (unpooled) connection used only for migrations.
# Required on Neon/Supabase, where the pooler cannot run DDL.
# Leave unset for a local Postgres; it falls back to DATABASE_URL.
# DIRECT_URL="postgresql://USER:PASSWORD@HOST/portfolio_tracker?sslmode=require"
